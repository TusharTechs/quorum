# Copy to .env and edit. Every variable has a safe demo default in docker-compose.yml.
QUORUM_ENV=demo                      # demo | production
QUORUM_DEMO=1                        # 0 in production (no seeded demo credentials)
QUORUM_PUBLIC_ORIGIN=http://localhost:8080
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_ALLOWED_HOSTS=*
POSTGRES_PASSWORD=quorum
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=0
TRUSTED_PROXY_IPS=127.0.0.1
QUORUM_BUILD=local
# Optional
# TRUSTED_CLIENT_IP_HEADER=X-Real-IP # a platform edge's own client-address header (read only from trusted proxies)
# WEB_CONCURRENCY=4                  # processes per replica (default: container CPUs, max 8, within its memory)
# WEB_THREADS=4
# DATABASE_URL=postgres://user:password@host:5432/quorum   # instead of POSTGRES_*, as hosted databases provide
# QUORUM_PUBLIC_DEMO=0               # 1: hosted public demo (hourly reset, no outbound mail); see OPERATIONS.md
# QUORUM_DEMO_RESET_MINUTES=60
