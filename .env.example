# Copy to .env and edit. Every variable has a safe demo default in docker-compose.yml.
QUORUM_ENV=demo                      # demo | production
QUORUM_DEMO=1                        # 0 in production (no seeded demo credentials)
QUORUM_PUBLIC_ORIGIN=http://localhost:8080
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_ALLOWED_HOSTS=*
POSTGRES_PASSWORD=quorum
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=0
TRUSTED_PROXY_IPS=127.0.0.1
QUORUM_BUILD=local
